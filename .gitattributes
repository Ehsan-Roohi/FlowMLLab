* text=auto
.gitattributes text eol=lf

# Keep checksummed and generated text evidence byte-stable across platforms.
*.cff text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Scientific and publication assets must never receive newline conversion.
*.gif binary
*.npz binary
*.npy binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.pptx binary
*.zip binary

# Large generated vector contours are figure assets, not hand-written source.
results/abinitio_deeponet_cylinder/*.svg binary -whitespace linguist-generated=true

# Preserve author-supplied DSMC tables byte-for-byte, including legacy line endings.
data/aescte_dsmc/raw/** -text -whitespace
