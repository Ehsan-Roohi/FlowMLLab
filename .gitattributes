* text=auto
.gitattributes text eol=lf

# Keep checksummed and generated text evidence byte-stable across platforms.
*.cff text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.sbatch text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Scientific and publication assets must never receive newline conversion.
*.gif binary
*.npz binary
*.pt binary
*.npy binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.pptx binary
*.zip binary
*.vtu binary

# Large generated vector contours are figure assets, not hand-written source.
results/abinitio_deeponet_cylinder/*.svg binary -whitespace linguist-generated=true

# Preserve author-supplied DSMC tables byte-for-byte, including legacy line endings.
data/aescte_dsmc/raw/** -text -whitespace
data/nozzle_bird_pr/*.dat -text -whitespace
data/week13_deep_cavity/audit.json -text
data/week13_deep_cavity/loss_continuation.dat -text

# Preserve retained Transolver CSV bytes, including their original CRLF endings.
results/step_transolver/comparison.csv -text
results/step_transolver/seed_17/case_metrics.csv -text
results/step_transolver/seed_29/case_metrics.csv -text
results/step_transolver/seed_43/case_metrics.csv -text

# Frozen cavity evidence is identified by raw SHA256; preserve its original bytes.
